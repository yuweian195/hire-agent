# LLM is optional. Leave LLM_API_KEY empty to run the deterministic offline mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional overrides
# DATABASE_PATH=data/hire_agent.db
# RECOMMEND_THRESHOLD=8.0
# HOLD_THRESHOLD=6.0

# Optional Java ATS integration service
# ATS_BASE_URL=http://127.0.0.1:8080

# Do not send candidate name/contact details to LLM prompts
REDACT_PII=true
